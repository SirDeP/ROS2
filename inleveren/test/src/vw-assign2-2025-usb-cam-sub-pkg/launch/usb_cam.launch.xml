<launch>
    <let name="rviz_config_path"
        value="$(find-pkg-share vw-assign2-2025-usb-cam-sub-pkg)/rviz/config.rviz" />
    <node pkg="usb_cam_vw" exec="usb_cam_vw_node_exe" name="usb_cam_node" output="screen">
        <param name="video_device" value="/dev/video0" />
        <param name="image_width" value="1280" />
        <param name="image_height" value="720" />
    </node>
    <node pkg="vw-assign2-2025-usb-cam-sub-pkg" exec="usb_cam_sub_node">
        <param name="edge_detection_choice" value="1" />
        <param name="circle_radius" value="100" />
        <param name="circle_thickness" value="25" />
        <param name="circle_color" value="[0, 255, 0]" />
        <param name="canny_threshold1" value="100" />
        <param name="canny_threshold2" value="200" />
    </node>
    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)"/>
    <node pkg="rqt_reconfigure" exec="rqt_reconfigure" output="screen"/>
    <!-- <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)" /> -->
</launch>
